<UserControl x:Class="CClean.App.Views.CleanupHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <WrapPanel><Button x:Name="RefreshButton" Content="刷新清理记录" Click="Refresh"/><Button x:Name="RunPreviousButton" Content="上一页任务" Click="PreviousRuns" IsEnabled="False"/><Button x:Name="RunNextButton" Content="下一页任务" Click="NextRuns" IsEnabled="False"/></WrapPanel>
   <TextBlock x:Name="Status" Text="每页最多 200 次任务。中断不自动续删，缺失不等于上次删除成功。" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <DataGrid Grid.Row="1" x:Name="Runs" Height="180" SelectionChanged="Select" SelectionMode="Single" AutomationProperties.Name="历史任务">
   <DataGrid.Columns><DataGridTextColumn Header="本地时间" Binding="{Binding Created}" Width="180"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120"/><DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,12,0,6">
   <ComboBox x:Name="DetailMode" SelectedIndex="0" SelectionChanged="ModeChanged" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="历史详情类型"><ComboBoxItem Content="批准清单"/><ComboBoxItem Content="原始审计"/><ComboBoxItem Content="恢复核查"/></ComboBox>
   <TextBlock x:Name="DetailExplanation" Text="批准清单记录当时选择与排除，不代表全部执行成功。" Margin="0,6,0,4"/>
   <TextBlock x:Name="DetailStatus" Text="选择任务查看具体记录。" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <DataGrid Grid.Row="3" x:Name="Events" Height="260" SelectionMode="Single" AutomationProperties.Name="当前页历史详情">
   <DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="依据" Binding="{Binding Reason}" Width="300"/><DataGridTextColumn Header="本地时间" Binding="{Binding Time}" Width="180"/></DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="4" Margin="0,8,0,0"><Button x:Name="DetailPreviousButton" Content="上一页明细" Click="PreviousDetails" IsEnabled="False"/><Button x:Name="DetailNextButton" Content="下一页明细" Click="NextDetails" IsEnabled="False"/></WrapPanel>
 </Grid>
 </ScrollViewer>
</UserControl>
