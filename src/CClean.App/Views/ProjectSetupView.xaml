<UserControl x:Class="CClean.App.Views.ProjectSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <TabControl><TabItem Header="目录与发现"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="确认范围后，只读发现目录；选中候选并登记后才持续监测。" Margin="0,0,0,12"/>
   <TextBlock Text="项目名称"/><TextBox x:Name="ProjectName" AutomationProperties.Name="项目名称" Margin="0,4,0,10"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="选择目录" Click="Browse"/><TextBlock Text="目录路径" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="RootPath" AutomationProperties.Name="目录路径" Margin="0,4,0,10"/>
   <DockPanel Margin="0,0,0,12"><TextBlock Text="工具标签" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="Tool" SelectedIndex="0" MinHeight="36" AutomationProperties.Name="工具标签">
     <ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude Code"/><ComboBoxItem Content="ZCode"/><ComboBoxItem Content="通用工具"/>
    </ComboBox>
   </DockPanel>
   <WrapPanel><Button x:Name="DiscoverButton" Content="只读发现 / 继续" Click="Discover"/>
    <Button Content="取消发现" Click="Cancel"/><Button x:Name="RegisterButton" Content="确认登记此目录" Click="Register"/>
    <Button Content="暂停 / 恢复选中项目" Click="Pause"/></WrapPanel>
  </StackPanel>
  <TextBlock Grid.Row="1" x:Name="Feedback" Margin="0,4,0,12" Text="尚未发现。也可以直接输入已知目录登记。" AutomationProperties.LiveSetting="Polite"/>
  <TabControl Grid.Row="2">
   <TabItem Header="已登记范围"><DataGrid x:Name="Registered" SelectionMode="Single">
    <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="目录" Binding="{Binding Root}" Width="*"/>
     <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="110"/><DataGridCheckBoxColumn Header="暂停" Binding="{Binding Paused}" Width="70"/></DataGrid.Columns>
   </DataGrid></TabItem>
   <TabItem Header="发现候选"><DataGrid x:Name="Candidates" SelectionChanged="SelectCandidate" SelectionMode="Single">
    <DataGrid.Columns><DataGridTextColumn Header="目录（需确认）" Binding="{Binding Path}" Width="*"/>
     <DataGridTextColumn Header="已知字节" Binding="{Binding KnownBytes}" Width="110"/><DataGridTextColumn Header="未知数" Binding="{Binding Unknown}" Width="80"/></DataGrid.Columns>
   </DataGrid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="只显示项目候选，排除系统范围。自动发现的会话请在左侧“项目会话”查看。登记不授予删除权限。" Margin="0,12,0,0"/>
 </Grid></TabItem></TabControl>
</UserControl>
