<UserControl x:Class="CClean.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="登记范围内的 C 盘空间" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <UniformGrid Columns="3">
   <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="已知逻辑大小" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Logical" FontSize="28" Margin="0,12,0,0" Text="尚未建立索引"/></StackPanel></Border>
   <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="分配估算" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Allocated" FontSize="28" Margin="0,12,0,0" Text="未知"/></StackPanel></Border>
   <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="相对登记基线净变化" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Growth" FontSize="28" Margin="0,12,0,0" Text="未知"/></StackPanel></Border>
  </UniformGrid>
  <TextBlock x:Name="Coverage" Text="尚未登记范围。先到项目与设置确认目录。" Margin="0,20,0,10"/>
  <TextBlock Text="这里只统计 C 盘登记范围，跨盘项目仍可登记，但不并入 C 盘占用。硬链接按身份去重；未知对象不作为 0 B 汇总。" Foreground="{DynamicResource Muted}" Margin="0,0,0,20"/>
  <Button Content="刷新索引统计" Click="Refresh" HorizontalAlignment="Left"/>
  <Border Background="{DynamicResource Panel}" Padding="20" CornerRadius="8" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="先理解增长，再决定清理" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="目录变化只是观察证据。共享缓存、未知来源与活跃项目受到保护；任何清理都需要重新生成预览。" Margin="0,10,0,0"/>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
