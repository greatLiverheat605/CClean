<UserControl x:Class="CClean.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
 <StackPanel Margin="0,0,12,0">
  <Border Style="{StaticResource Card}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0">
     <TextBlock Text="给开发留出更多空间" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock x:Name="DiskSummary" Text="正在读取磁盘…" Margin="0,8,0,10" Foreground="{DynamicResource Muted}"/>
     <ProgressBar x:Name="DiskUsage" Height="8" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" AutomationProperties.Name="系统盘已用比例"/>
     <TextBlock Text="先清理系统临时文件；项目源码和版本副本保留。" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <Button Style="{StaticResource Primary}" Click="OpenDiskCleanup" Margin="0,0,0,8" AutomationProperties.Name="快速清理临时文件"><TextBlock Text="快速清理临时文件" Foreground="{DynamicResource OnAccent}"/></Button>
     <Button Content="Windows 存储设置" Click="OpenStorage" Margin="0,0,0,8"/>
     <Button Content="预览旧崩溃转储" Click="PreviewDumps" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
  <TextBlock Text="Windows 会展示清理清单并让你确认。请选择缓存 / 临时文件，保留下载和回收站中仍需要的内容。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,8,0,18"/>
  <DockPanel Margin="0,0,0,10">
   <TextBlock DockPanel.Dock="Left" Text="空间盘点" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <TextBlock Text="只读扫描 · 已排除系统文件" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="ScanRoot" AutomationProperties.Name="盘点目录" Margin="0,0,8,0"/>
   <Button Grid.Column="1" x:Name="BrowseButton" Content="选目录" Click="Browse" Margin="0,0,8,0"/>
   <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource Primary}" Click="Scan" Margin="0,0,8,0" AutomationProperties.Name="开始或继续盘点"><TextBlock x:Name="ScanLabel" Text="开始盘点" Foreground="{DynamicResource OnAccent}"/></Button>
   <Button Grid.Column="3" x:Name="CancelButton" Content="停止" IsEnabled="False" Click="Cancel" Margin="0"/>
  </Grid>
  <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ScanStatus" Text="点击开始盘点，发现项目和用户目录；系统文件与系统目录不列出。" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,12,0"/>
   <ComboBox Grid.Column="1" x:Name="Filter" SelectedIndex="0" MinWidth="170" SelectionChanged="FilterChanged" AutomationProperties.Name="盘点分类">
    <ComboBoxItem Content="空间占用排行"/><ComboBoxItem Content="项目与版本副本"/><ComboBoxItem Content="常见缓存"/>
   </ComboBox>
  </Grid>
  <ProgressBar x:Name="ScanProgress" Height="3" Visibility="Collapsed" IsIndeterminate="True" Foreground="{DynamicResource Accent}"/>
  <DataGrid x:Name="Results" Height="245" SelectionMode="Single" SelectionChanged="SelectionChanged" CanUserAddRows="False" AutomationProperties.Name="空间盘点结果" HeadersVisibility="Column" BorderBrush="{DynamicResource Line}" BorderThickness="1">
   <DataGrid.Columns>
    <DataGridTextColumn Header="目录" Binding="{Binding Name}" Width="*"/>
    <DataGridTemplateColumn Header="已盘点大小" Width="155" SortMemberPath="Bytes"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="6,2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/></Grid.RowDefinitions><TextBlock Text="{Binding Size}" FontSize="12" VerticalAlignment="Center"/><ProgressBar Grid.Row="1" Value="{Binding Share}" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" AutomationProperties.Name="占已盘点文件大小比例"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="140"/>
    <DataGridTextColumn Header="文件数" Binding="{Binding Files}" Width="80"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16">
   <StackPanel>
    <TextBlock x:Name="SelectedPath" Text="选中一个目录，查看位置和下一步操作。" FontWeight="SemiBold"/>
    <TextBlock x:Name="Advice" Text="按路径统计逻辑大小，硬链接可能重复；父子目录不能相加，大小不等于可释放空间。" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
    <WrapPanel>
     <Button x:Name="OpenFolderButton" Content="打开文件夹" Click="OpenFolder" IsEnabled="False"/>
     <Button x:Name="DrillButton" Content="深入盘点此目录" Click="Drill" IsEnabled="False"/>
     <Button x:Name="RegisterButton" Content="加入持续监测" Click="Register" IsEnabled="False"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Expander Header="已登记项目的增长监测" Margin="0,18,0,12" Foreground="{DynamicResource Ink}">
   <StackPanel Margin="0,12,0,0">
    <UniformGrid Columns="3"><StackPanel><TextBlock Text="已知逻辑大小" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Logical" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="分配估算" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Allocated" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="登记后净变化" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Growth" FontSize="20"/></StackPanel></UniformGrid>
    <TextBlock x:Name="Coverage" Margin="0,12,0,8" Foreground="{DynamicResource Muted}"/>
    <Button Content="刷新监测统计" Click="Refresh" HorizontalAlignment="Left"/>
   </StackPanel>
  </Expander>
 </StackPanel>
 </ScrollViewer>
</UserControl>
