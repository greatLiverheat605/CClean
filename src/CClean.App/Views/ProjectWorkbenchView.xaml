<UserControl x:Class="CClean.App.Views.ProjectWorkbenchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid x:Name="ModulesPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="你的项目" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="先选择项目，再查看开发时间线、文件占用、清理位置和会话。发现的工具工作目录也会列出，登记后才记录文件变化。" Foreground="{DynamicResource Muted}" Margin="0,8,0,14"/>
    <Expander Header="发现更多项目" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="选择项目所在的父目录，只读发现代码项目；不会自动登记或启用清理。" Foreground="{DynamicResource Muted}"/>
     <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="选择目录…" Click="ChooseDiscoveryRoot"/><TextBox x:Name="DiscoveryRoot" AutomationProperties.Name="项目发现范围" Margin="0,0,8,8"/></DockPanel>
     <WrapPanel><Button x:Name="DiscoverButton" Content="发现 / 继续" Click="DiscoverProjects"/><Button Content="停止发现" Click="StopDiscovery"/></WrapPanel>
     <TextBlock x:Name="DiscoveryStatus" Foreground="{DynamicResource Muted}" Text="发现结果只在本次运行保留；支持分批继续。"/>
    </StackPanel></Expander>
    <TextBlock Text="搜索项目名称或路径"/><DockPanel Margin="0,6,0,8"><Button DockPanel.Dock="Right" Content="刷新项目" Click="Refresh"/><TextBox x:Name="Search" TextChanged="SearchChanged" Margin="0,0,12,8" AutomationProperties.Name="搜索项目模块"/></DockPanel>
   </StackPanel>
   <TextBlock Grid.Row="1" x:Name="ModuleStatus" Margin="0,0,0,10" Foreground="{DynamicResource Muted}"/>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Modules">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="OpenModule" Margin="0,0,14,14" Padding="18" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Name}"><StackPanel Width="235">
     <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
     <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" Margin="0,8,0,6"/>
     <TextBlock Text="{Binding Root}" Foreground="{DynamicResource Muted}" Height="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
     <TextBlock Text="{Binding SessionLabel}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
     <TextBlock Text="打开项目 →" Margin="0,12,0,0"/>
    </StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl></ScrollViewer>
  </Grid>
  <Grid x:Name="DetailPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Left" Content="← 所有项目" Click="Back"/><Button DockPanel.Dock="Right" x:Name="RegisterButton" Content="加入持续监测" Click="Register"/>
    <StackPanel Margin="8,0,8,8"><TextBlock x:Name="ProjectTitle" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ProjectPath" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
   </DockPanel>
   <StackPanel Grid.Row="1"><TextBlock x:Name="ProjectStatus" Margin="0,0,0,6" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,10"><TextBlock x:Name="ProjectSummary" Text="正在读取项目概览…" AutomationProperties.LiveSetting="Polite"/></Border>
   </StackPanel>
   <TabControl Grid.Row="2" x:Name="Sections" SelectionChanged="SectionChanged">
    <TabItem Header="开发时间线"><ContentControl x:Name="TimelineContent"/></TabItem>
    <TabItem Header="文件与空间"><ContentControl x:Name="FilesContent"/></TabItem>
    <TabItem Header="清理位置"><ContentControl x:Name="SpaceContent"/></TabItem>
    <TabItem Header="项目会话"><ContentControl x:Name="SessionsContent"/></TabItem>
    <TabItem Header="版本比较"><ContentControl x:Name="ComparisonContent"/></TabItem>
   </TabControl>
  </Grid>
 </Grid>
</UserControl>
