<UserControl x:Class="CClean.App.Views.TimelineView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CClean.App.Controls">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="观察时间"/><ComboBox x:Name="TimeRange" Width="125" MinHeight="36" SelectedIndex="1" SelectionChanged="Filter" AutomationProperties.Name="时间范围"><ComboBoxItem Content="最近 15 分钟"/><ComboBoxItem Content="最近 1 小时"/><ComboBoxItem Content="最近 24 小时"/><ComboBoxItem Content="最近 7 天"/></ComboBox></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="项目"/><ComboBox x:Name="ProjectFilter" Width="160" MinHeight="36" SelectionChanged="Filter" AutomationProperties.Name="时间线项目"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="工具"/><ComboBox x:Name="ToolFilter" Width="130" MinHeight="36" SelectedIndex="0" SelectionChanged="Filter" AutomationProperties.Name="时间线工具"><ComboBoxItem Content="全部工具"/><ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude Code"/><ComboBoxItem Content="ZCode"/></ComboBox></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="依据"/><ComboBox x:Name="EvidenceFilter" Width="130" MinHeight="36" SelectedIndex="0" SelectionChanged="Filter" AutomationProperties.Name="归因依据"><ComboBoxItem Content="全部依据"/><ComboBoxItem Content="上下文关联"/><ComboBoxItem Content="共享"/><ComboBoxItem Content="未知"/></ComboBox></StackPanel>
   <Button Content="刷新时间线" Click="Refresh" VerticalAlignment="Bottom"/>
  </WrapPanel>
  <TextBlock Grid.Row="1" x:Name="Coverage" Margin="0,0,0,12" Text="历史加载中…"/>
  <TabControl Grid.Row="2">
   <TabItem Header="分支图"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="横轴为观察时间；圆点表示上下文或未知，方点表示共享；虚线与文字区分依据。左右键选择，详情见下方。" Margin="8"/>
    <ScrollViewer Grid.Row="1" Focusable="False" KeyboardNavigation.IsTabStop="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><controls:TimelineCanvas x:Name="Graph"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="列表（键盘替代）"><DataGrid x:Name="Nodes" SelectionMode="Single" SelectionChanged="SelectNode">
    <DataGrid.Columns><DataGridTextColumn Header="观察时间" Binding="{Binding LocalTime}" Width="145"/><DataGridTextColumn Header="依据" Binding="{Binding EvidenceLabel}" Width="110"/>
     <DataGridTextColumn Header="目录" Binding="{Binding Directory}" Width="*"/><DataGridTextColumn Header="净变化" Binding="{Binding NetDisplay}" Width="130"/></DataGrid.Columns>
   </DataGrid></TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="115" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="时间线节点详情" Text="选择一个变化节点，查看路径、依据和前后值。历史不是 Git 回滚，也不直接授权删除。"/>
   <Button Grid.Column="1" Content="查看当前目录文件" Click="OpenFiles" Margin="12,0,0,0" VerticalAlignment="Top"/>
  </Grid>
 </Grid>
</UserControl>
