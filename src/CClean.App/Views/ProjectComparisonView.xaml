<UserControl x:Class="CClean.App.Views.ProjectComparisonView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="只读比较另一版本；相同内容不代表整个版本可删除。" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
   <TextBlock x:Name="CurrentPath" Visibility="Collapsed"/>
   <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择另一版本…" Click="Browse"/><TextBox x:Name="OtherPath" IsReadOnly="True" AutomationProperties.Name="另一版本目录" Margin="0,0,8,8"/></DockPanel>
   <WrapPanel><Button x:Name="CompareButton" Content="开始只读比较" Click="Compare" IsEnabled="False"/><Button x:Name="CancelButton" Content="取消" Click="Cancel" IsEnabled="False"/><ComboBox x:Name="Filter" Width="200" Height="42" Margin="0,0,0,8" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="比较结果筛选"><ComboBoxItem Content="差异与未比较"/><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="独有文件"/><ComboBoxItem Content="内容相同"/></ComboBox></WrapPanel>
  </StackPanel>
  <TextBlock Grid.Row="1" x:Name="Status" Text="选择另一版本文件夹后开始比较。不会读取已识别的敏感文件或工具私有数据。" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Grid.Row="2" x:Name="TableStatus" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
  <DataGrid Grid.Row="3" x:Name="Results" SelectionChanged="Selected" SelectionMode="Single" AutomationProperties.Name="版本比较明细"><DataGrid.Columns>
   <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="比较结果" Binding="{Binding Label}" Width="150"/><DataGridTextColumn Header="当前项目" Binding="{Binding LeftSize}" Width="100"/><DataGridTextColumn Header="另一版本" Binding="{Binding RightSize}" Width="100"/>
  </DataGrid.Columns></DataGrid>
  <TextBox Grid.Row="4" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="版本比较依据" Text="每侧最多盘点 10,000 项，合计最多读取 512 MiB 内容，单次时间预算 30 秒；较大项目请比较具体子目录。"/>
 </Grid>
</UserControl>
