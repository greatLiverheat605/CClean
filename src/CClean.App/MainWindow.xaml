<Window x:Class="CClean.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CClean.App"
        mc:Ignorable="d"
        Title="CClean · 开发空间工作台" Height="820" Width="1240" MinHeight="500" MinWidth="760"
        Loaded="OnLoaded" Closed="OnClosed" Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DockPanel x:Name="SidebarBody" Margin="18,28">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,32">
                    <TextBlock Text="CClean" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="空间整理 · 开发守护" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="管理范围" Click="OpenScopeManagement"/>
                    <Button Content="处理历史" Click="OpenHistory"/>
                    <Button Content="设置与覆盖说明" Click="OpenSettings"/>
                    <Button Content="退出 CClean" Click="ExitClicked" Margin="0,12,0,0"/>
                    <TextBlock Text="本地处理 · 受控范围" Foreground="{DynamicResource Muted}" Margin="10,0,0,12"/>
                    <Button Content="切换浅色 / 深色" Click="ToggleTheme" AutomationProperties.Name="切换主题"/>
                </StackPanel>
                <ListBox x:Name="Navigation" SelectionChanged="Navigate" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Ink}" AutomationProperties.Name="主导航">
                    <ListBox.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.Resources>
                    <ListBoxItem Content="空间与清理"/>
                    <ListBoxItem Content="开发活动"/>
                    <ListBoxItem Content="项目与版本"/>
                </ListBox>
            </DockPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Margin="24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="刷新容量" Click="Refresh"/>
                <StackPanel><TextBlock x:Name="PageTitle" Text="空间与清理" FontSize="28" FontWeight="SemiBold"/>
                    <Expander Header="各磁盘容量 · 整卷测量" Margin="0,4,0,0"><TextBlock x:Name="Capacity" Text="正在读取本机各卷容量…" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></Expander></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="{DynamicResource Panel}" Padding="12,8" Margin="0,0,0,12" CornerRadius="6">
                <DockPanel><Button DockPanel.Dock="Right" Content="管理范围" Click="OpenScopeManagement" Margin="12,0,0,0"/>
                    <TextBlock x:Name="Status" Text="尚未登记目录。登记后才会在确认范围内监测。" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
            </Border>
            <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button x:Name="ReturnButton" Content="← 返回工作区" Click="ReturnToWorkspace" HorizontalAlignment="Left" Visibility="Collapsed"/>
                <ContentControl Grid.Row="1" x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
            <TextBlock Grid.Row="3" Text="本地只读盘点 · 持续监测需登记 · 永久删除需单独确认"
                       Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,0"/>
        </Grid>
    </Grid>
</Window>
